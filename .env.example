# Bootstrap account used to create circles and invite members.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Local origin for practice mode. Use the public HTTPS address for Roqqu links.
PUBLIC_URL=http://localhost:3000

# Leave the API key blank for practice mode. Never commit your real key.
ROQQU_API_KEY=
# Defaults to staging/test mode when a key is present. Use "live" only for production.
ROQQU_MODE=staging
ROQQU_BASE_URL=https://service.roqqu.com/v1

# Optional storage paths
# DATA_FILE=./data.json
# UPLOAD_DIR=./uploads
